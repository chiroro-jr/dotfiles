{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "agent": {
    "build": {
      "model": "github-copilot/gpt-5.4"
    },
    "plan": {
      "model": "github-copilot/gpt-5.4"
    },
    "general": {
      "model": "github-copilot/gpt-5.3-codex"
    },
    "explore": {
      "model": "firepass/accounts/fireworks/routers/kimi-k2p6-turbo"
    }
  },
  "mcp": {
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ],
      "enabled": true
    },
    "pencil": {
      "command": [
        "sh",
        "-lc",
        "exec \"$HOME/.pencil/mcp/vscodium/out/mcp-server-linux-x64\" --app vscodium --agent openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "plugin": [
    "@plannotator/opencode@latest"
  ]
}