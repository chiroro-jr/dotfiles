{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "agent": {
    "build": {
      "model": "openai/gpt-6-sol",
       "reasoningEffort": "high",
    },
    "plan": {
      "model": "openai/gpt-6-astra",
       "reasoningEffort": "high",
    },
    "general": {
      "model": "openai/gpt-6-sol",
       "reasoningEffort": "high",
    },
    "explore": {
      "model": "openai/gpt-6-luna-fast",
      "reasoningEffort": "high",
    },
    "scout": {
      "model": "openai/gpt-6-luna-fast",
      "reasoningEffort": "high",
      "mode": "all"
    }
  },
  "mcp": {
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ],
      "enabled": true
    },
    "pencil": {
      "command": [
        "/home/chiroro/.local/share/pen/resources/app.asar.unpacked/out/mcp-server-linux-x64",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    },
    "wonder": {
      "type": "remote",
      "url": "https://mcp.wonder.so/mcp"
    }
  }
}
