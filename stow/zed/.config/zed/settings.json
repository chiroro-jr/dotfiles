{
  // FONT & TEXT SETTINGS
  "git": {
    "git_gutter": "hide",
    "inline_blame": {
      "enabled": true
    }
  },
  "scrollbar": {
    "git_diff": false
  },
  "project_panel": {
    "hide_gitignore": false
  },
  "edit_predictions": {
    "mode": "eager"
  },
  "ui_font_family": ".ZedMono",
  "show_edit_predictions": true,
  "ui_font_size": 16,
  "buffer_font_size": null,
  "buffer_font_weight": 500,
  "buffer_line_height": {
    "custom": 2.8
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_features": {
    "calt": true
  },

  // EDITOR CORE SETTINGS
  // "base_keymap": "VSCode",
  "features": {
    "edit_prediction_provider": "copilot"
  },
  "middle_click_paste": false,
  "autosave": "on_focus_change",
  "preferred_line_length": 100,
  "soft_wrap": "preferred_line_length",

  // TAB SETTINGS
  "max_tabs": null,
  "tab_bar": {
    "show": false,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "git_status": true,
    "close_position": "right",
    "file_icons": true,
    "show_close_button": "always",
    "activate_on_close": "history",
    "show_diagnostics": "all"
  },
  "preview_tabs": {
    "enabled": false
  },

  // TERMINAL SETTINGS
  "terminal": {
    "shell": "system",
    "font_family": ".ZedMono",
    "font_size": 16,
    "toolbar": {
      "breadcrumbs": true
    },
    "scrollbar": {
      "show": "auto"
    }
  },

  // VISUAL SETTINGS
  "icon_theme": "VSCode Great Icons Theme",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "KTRZ Monokai"
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false
  },
  "gutter": {
    "line_numbers": true,
    "runnables": true,
    "folds": true
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },

  // PANEL & SIDEBAR SETTINGS
  "outline_panel": {
    "button": true,
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": null
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "grok-code-fast-1"
    },
    "default_profile": "write",
    "always_allow_tool_actions": true,
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5"
    }
  },

  "context_servers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "ctx7sk-969d2eb8-ec89-4b6a-89e3-d25f704b11f7"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "cognitionai/deepwiki": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.deepwiki.com/sse"]
    }
  },

  // SYSTEM SETTINGS
  "auto_update": false
}
