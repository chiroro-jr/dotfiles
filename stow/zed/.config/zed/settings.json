{
  "diff_view_style": "unified",
  "cli_default_open_behavior": "new_window",
  "debugger": {
    "dock": "right",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right",
  },
  "lsp": {
    // "vtsls": {
    //   "settings": {
    //     "typescript": {
    //       "updateImportsOnFileMove": {
    //         "enabled": "always",
    //       },
    //     },
    //     "javascript": {
    //       "updateImportsOnFileMove": {
    //         "enabled": "always",
    //       },
    //     },
    //   },
    //   "enable_lsp_tasks": true,
    // },
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "git": {
    "worktree_directory": "../worktrees",
  },
  "edit_predictions": {
    "mode": "eager",
    "provider": "zed",
  },
  "formatter": "auto",
  "ui_font_family": ".ZedMono",
  "ui_font_size": 16,
  "buffer_font_size": null,
  "buffer_font_weight": 500,
  "buffer_line_height": {
    "custom": 2.8,
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_features": {
    "calt": true,
  },
  "middle_click_paste": false,
  "autosave": "on_focus_change",
  "preferred_line_length": 120,
  "soft_wrap": "bounded",
  "terminal": {
    "shell": "system",
    "font_family": ".ZedMono",
    "font_size": 16,
    "toolbar": {
      "breadcrumbs": true,
    },
    "scrollbar": {
      "show": "auto",
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "Flow Deep",
    "dark": "Warm Charmed Icons",
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Soft",
  },
  "theme_overrides": {
    "Aura Dark": {
      "border.variant": "#15141C",
      "border": "#15141C",
      "title_bar.background": "#15141C",
      "panel.background": "#15141C",
      "panel.focused_border": "#4E466E",
      "players": [
        {
          "cursor": "#BD9DFF",
        },
      ],
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },
  "tab_bar": {
    "show": false,
  },
  "preview_tabs": {
    "enabled": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "experimental.show": true,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 200,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "git_status": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
  "outline_panel": {
    "button": false,
    "dock": null,
    "default_width": 300,
    "indent_guides": {
      "show": "never",
    },
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "show_edit_predictions": true,
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "developer.android.com"
      ]
    },
    "flexible": true,
    "notify_when_agent_waiting": "primary_screen",
    "play_sound_when_agent_done": "always",
    "dock": "left",
    "tool_permissions": {
      "default": "allow",
    },
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "grok-code-fast-1",
    },
    "default_profile": "write",
    "model_parameters": [],
    "use_modifier_to_send": true,
  },
  "context_servers": {
    "pencil": {
      "command": "/home/dennis/.local/share/pencil/resources/app.asar.unpacked/out/mcp-server-linux-x64",
      "args": ["--app", "desktop"],
      "enabled": true,
    },
  },
  // SYSTEM SETTINGS
  "auto_update": false,
  // LANGUAGES
  "languages": {
    "TypeScript": {
      "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "!eslint", "..."],
    },
    "TSX": {
      "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "!eslint", "..."],
    },
    "JavaScript": {
      "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "!eslint", "..."],
    },
    "JSX": {
      "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "!eslint", "..."],
    },
    "Vue.js": {
      "language_servers": ["!eslint", "..."],
    },
    "Astro": {
      "language_servers": ["!eslint", "..."],
    },
    "Svelte": {
      "language_servers": ["!eslint", "..."],
    },
  },
  "language_models": {
    "opencode": {
      "show_free_models": false,
      "show_zen_models": false,
    },
    "openai_compatible": {},
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
  },
}
